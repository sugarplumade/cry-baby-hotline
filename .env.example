# Local app port (Render sets PORT automatically)
PORT=3003

# Data directory for messages/uploads
# Local default can be omitted; on Render use a persistent disk mount path, e.g. /var/data
HOTLINE_DATA_DIR=

# Public base URL for Twilio callbacks
# Example (local tunnel): https://abc123.ngrok-free.dev
# Example (deployed): https://cry-baby-hotline.onrender.com
PUBLIC_BASE_URL=

# Twilio credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Optional transcription settings
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
TRANSCRIPTION_ADMIN_TOKEN=

# Optional Twilio call settings
TWILIO_GREETING=You reached Cry Baby Hotline. Leave your worry after the beep. Your message may be shared publicly.
TWILIO_MAX_LENGTH_SECONDS=120
